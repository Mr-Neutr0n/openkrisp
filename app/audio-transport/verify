#!/usr/bin/env python3
import pathlib
import subprocess
import tempfile

source = pathlib.Path(__file__).resolve().parent / "test.cpp"
with tempfile.TemporaryDirectory(prefix="krisp-transport-") as build:
    for name, flags in [
        ("release", ["-O2"]),
        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"]),
        ("thread", ["-O1", "-g", "-fsanitize=thread"]),
    ]:
        binary = str(pathlib.Path(build) / name)
        subprocess.run([
            "clang++", "-std=c++20", "-Wall", "-Wextra", "-Werror",
            "-pedantic", "-pthread", *flags, str(source), "-o", binary,
        ], check=True)
        print(name, flush=True)
        subprocess.run([binary], check=True)

with tempfile.TemporaryDirectory(prefix="krisp-shared-transport-") as build:
    source = pathlib.Path(__file__).resolve().parent / "shared_test.cpp"
    for name, flags in [("shared-release", ["-O2"]),
                        ("shared-address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"])]:
        binary = str(pathlib.Path(build) / name)
        subprocess.run(["clang++", "-std=c++20", "-Wall", "-Wextra", "-Werror",
                        "-pedantic", "-pthread", *flags, str(source), "-o", binary], check=True)
        print(name, flush=True)
        subprocess.run([binary], check=True)
