#!/usr/bin/env python3
"""Build and inspect a development-only package. Never install or restart audio."""
import hashlib
import json
import os
import pathlib
import plistlib
import shutil
import struct
import subprocess
import tempfile
import xml.etree.ElementTree as ET

root = pathlib.Path(__file__).resolve().parent
subprocess.run([str(root / "verify")], check=True)
discovery_trace = os.environ.get("LABVOICE_DISCOVERY_TRACE") == "1"
output = root / "build" / ("package-discovery-trace" if discovery_trace else "package")
output.mkdir(parents=True, exist_ok=True)
bundle_name = "LabVoiceAudio.driver"
bundle_id = "dev.hari.labvoice.audio"
package_id = "dev.hari.labvoice.audio.development"
location = "/Library/Audio/Plug-Ins/HAL"
preinstall = '''#!/bin/sh
set -eu
# Development package: current startup volume only, never replace an existing path.
if [ "${3:-}" != "/" ]; then
    echo "Lab Voice Audio: only the current startup volume is supported." >&2
    exit 1
fi
target=/Library/Audio/Plug-Ins/HAL/LabVoiceAudio.driver
if [ -e "$target" ] || [ -L "$target" ]; then
    echo "Lab Voice Audio: target already exists. Refusing to overwrite it." >&2
    exit 1
fi
exit 0
'''

def files_for(bundle):
    result = {}
    if bundle.is_symlink() or not bundle.is_dir():
        raise RuntimeError("bundle must be a plain directory")
    for path in sorted(bundle.rglob("*")):
        if path.is_symlink():
            raise RuntimeError("symlink in driver bundle")
        if path.is_file():
            result[path.relative_to(bundle).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
        elif not path.is_dir():
            raise RuntimeError("unexpected special file")
    return result

def tree_hash(files):
    return hashlib.sha256(json.dumps(files, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()

with tempfile.TemporaryDirectory(prefix="labvoice-driver-package-") as staging:
    stage = pathlib.Path(staging)
    payload = stage / "payload"
    payload.mkdir()
    signed = payload / bundle_name
    shutil.copytree(root / "build" / bundle_name, signed)
    info_path = signed / "Contents" / "Info.plist"
    with info_path.open("rb") as handle:
        info = plistlib.load(handle)
    if info["CFBundleIdentifier"] != bundle_id or info["CFBundleExecutable"] != "LabVoiceAudio":
        raise RuntimeError("unexpected driver identity")
    # Clear inherited metadata. macOS can regenerate provenance xattrs,
    # whose AppleDouble archive records are validated below.
    subprocess.run(["xattr", "-cr", str(payload)], check=True)
    subprocess.run(["codesign", "--force", "--sign", "-", str(signed)], check=True)
    subprocess.run(["codesign", "--verify", "--strict", str(signed)], check=True)
    signatures = subprocess.run(["codesign", "--display", "--verbose=4", str(signed)],
                                capture_output=True, text=True, check=True)
    signature_text = signatures.stdout + signatures.stderr
    if "Signature=adhoc" not in signature_text or "Identifier=" + bundle_id not in signature_text:
        raise RuntimeError("expected ad-hoc bundle signature")
    expected_files = files_for(signed)
    scripts = stage / "scripts"
    scripts.mkdir()
    (scripts / "preinstall").write_text(preinstall)
    (scripts / "preinstall").chmod(0o755)
    # Check the package's actual refusal path without touching a system path.
    rejected = subprocess.run([str(scripts / "preinstall"), "fixture", "fixture", "/not-the-startup-volume"],
                              capture_output=True, text=True)
    if rejected.returncode != 1:
        raise RuntimeError("preinstall did not reject an alternate target volume")
    components = stage / "components.plist"
    with components.open("wb") as handle:
        plistlib.dump([{"RootRelativeBundlePath": bundle_name,
                       "BundleIsRelocatable": False,
                       "BundleIsVersionChecked": False,
                       "BundleHasStrictIdentifier": True,
                       "BundleOverwriteAction": "upgrade"}], handle)
    package = stage / "LabVoiceAudio-development.pkg"
    subprocess.run(["pkgbuild", "--root", str(payload), "--component-plist", str(components),
                    "--scripts", str(scripts), "--install-location", location,
                    "--identifier", package_id, "--version", info["CFBundleVersion"],
                    "--ownership", "recommended", str(package)], check=True)
    entries = subprocess.check_output(["pkgutil", "--payload-files", str(package)], text=True).splitlines()
    expected_paths = {".", bundle_name}
    for file in expected_files:
        path = pathlib.PurePosixPath(bundle_name) / file
        expected_paths.add(str(path))
        expected_paths.update(str(parent) for parent in path.parents if str(parent) != ".")
    actual_paths = {entry.removeprefix("./").rstrip("/") or "." for entry in entries}
    plain_paths = set()
    metadata_paths = set()
    for entry in actual_paths:
        path = pathlib.PurePosixPath(entry)
        if path.name.startswith("._"):
            represented = str(path.with_name(path.name[2:]))
            if represented not in expected_paths:
                raise RuntimeError("metadata companion outside whitelisted scope: " + entry)
            metadata_paths.add(entry)
        else:
            plain_paths.add(entry)
    if plain_paths != expected_paths:
        raise RuntimeError(f"payload scope mismatch: extra={plain_paths - expected_paths}, missing={expected_paths - plain_paths}")
    flat = stage / "flat"
    subprocess.run(["pkgutil", "--expand", str(package), str(flat)], check=True)
    metadata_hashes = {}
    for entry in sorted(metadata_paths):
        # Extract one whitelisted archive member to memory without applying it.
        data = subprocess.check_output(["tar", "--no-mac-metadata", "-xOf", str(flat / "Payload"), "./" + entry])
        if not 26 <= len(data) <= 1048576:
            raise RuntimeError("invalid AppleDouble length")
        magic, version = struct.unpack_from(">II", data)
        count = struct.unpack_from(">H", data, 24)[0]
        directory_end = 26 + count * 12
        if magic != 0x00051607 or version != 0x00020000 or not 1 <= count <= 64 or directory_end > len(data):
            raise RuntimeError("invalid AppleDouble header")
        spans = []
        for index in range(count):
            _identifier, offset, length = struct.unpack_from(">III", data, 26 + index * 12)
            if offset < directory_end or offset + length > len(data):
                raise RuntimeError("invalid AppleDouble entry bounds")
            if length:
                spans.append((offset, offset + length))
        spans.sort()
        if any(first[1] > second[0] for first, second in zip(spans, spans[1:])):
            raise RuntimeError("overlapping AppleDouble entries")
        metadata_hashes[entry] = hashlib.sha256(data).hexdigest()
    expanded = stage / "expanded"
    subprocess.run(["pkgutil", "--expand-full", str(package), str(expanded)], check=True)
    embedded = expanded / "Payload" / bundle_name
    if files_for(embedded) != expected_files:
        raise RuntimeError("embedded signed bundle differs from staging")
    subprocess.run(["codesign", "--verify", "--strict", str(embedded)], check=True)
    package_info = ET.parse(expanded / "PackageInfo").getroot()
    if package_info.attrib.get("install-location") != location or package_info.attrib.get("identifier") != package_id:
        raise RuntimeError("package installation metadata differs")
    extracted_scripts = expanded / "Scripts"
    if sorted(p.name for p in extracted_scripts.iterdir()) != ["preinstall"] or (extracted_scripts / "preinstall").read_text() != preinstall:
        raise RuntimeError("unexpected installer scripts")
    bundle_records = package_info.findall("bundle")
    if len(bundle_records) != 1 or bundle_records[0].attrib.get("path", "").removeprefix("./") != bundle_name or package_info.attrib.get("relocatable") != "false" or len(package_info.find("relocate")) != 0:
        raise RuntimeError("package relocation is not disabled")
    signature_check = subprocess.run(["pkgutil", "--check-signature", str(package)], capture_output=True, text=True)
    if "no signature" not in (signature_check.stdout + signature_check.stderr).lower():
        raise RuntimeError("development package must remain unsigned")
    destination_bundle = output / bundle_name
    if destination_bundle.exists():
        shutil.rmtree(destination_bundle)
    shutil.copytree(embedded, destination_bundle)
    destination_pkg = output / package.name
    shutil.copy2(package, destination_pkg)
    manifest = {
        "schemaVersion": 1, "discoveryTrace": discovery_trace, "packageIdentifier": package_id,
        "bundleIdentifier": bundle_id, "bundleVersion": info["CFBundleVersion"],
        "installPath": location + "/" + bundle_name,
        "packageSHA256": hashlib.sha256(package.read_bytes()).hexdigest(),
        "bundleTreeSHA256": tree_hash(expected_files), "files": expected_files,
        "signature": "ad-hoc bundle, unsigned package",
        "preinstallSHA256": hashlib.sha256(preinstall.encode()).hexdigest(),
        "relocatable": False,
        "payloadFiles": sorted(expected_paths),
        "archiveMetadataAppleDouble": metadata_hashes,
        "verification": ["host factory tests", "payload exact path set plus bounded AppleDouble companions", "embedded file digest equality",
                         "embedded codesign --verify --strict", "install location and identifier",
                         "single preinstall guard, no postinstall", "relocation disabled", "unsigned package"],
    }
    manifest_path = output / "package-manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    (output / "preinstall-review.txt").write_text(preinstall)
    print("Package:", destination_pkg)
    print("Package SHA256:", manifest["packageSHA256"])
    print("Signed bundle:", destination_bundle)
    print("Bundle tree SHA256:", manifest["bundleTreeSHA256"])
    print("Manifest:", manifest_path)
    print("No installation, admin request, driver loading, or CoreAudio restart performed.")
