#!/bin/sh
set -eu
cd "$(dirname "$0")"
trace_flag=
if [ "${LABVOICE_DISCOVERY_TRACE:-0}" = "1" ]; then trace_flag=-DLABVOICE_DISCOVERY_TRACE; fi
mkdir -p build/LabVoiceAudio.driver/Contents/MacOS
cp Info.plist build/LabVoiceAudio.driver/Contents/Info.plist
clang++ $trace_flag -std=c++20 -Wall -Wextra -Werror -bundle driver.cpp -framework CoreAudio -framework CoreFoundation -o build/LabVoiceAudio.driver/Contents/MacOS/LabVoiceAudio
clang++ -std=c++20 -Wall -Wextra -Werror test.cpp -framework CoreAudio -framework CoreFoundation -o build/host-test
plutil -lint build/LabVoiceAudio.driver/Contents/Info.plist
./build/host-test "$PWD/build/LabVoiceAudio.driver/Contents/MacOS/LabVoiceAudio"
# The pause hook exists only in this separate test build, never in the shipped bundle.
clang++ $trace_flag -std=c++20 -Wall -Wextra -Werror -DLABVOICE_DRIVER_TEST_HOOKS -bundle driver.cpp -framework CoreAudio -framework CoreFoundation -o build/LabVoiceAudio-test.bundle
./build/host-test "$PWD/build/LabVoiceAudio-test.bundle"
