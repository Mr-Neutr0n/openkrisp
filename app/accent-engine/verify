#!/usr/bin/env python3
"""Verify the independent AR adapter against an owned foreign-ABI fixture."""
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent
subprocess.run([str(root / 'build_probe')], check=True)
with tempfile.TemporaryDirectory(prefix='openkrisp-ar-verify-') as directory:
    fixture = str(Path(directory) / 'fixture.dylib')
    subprocess.run(['clang++', '-std=c++20', '-arch', 'arm64', '-O2', '-Wall',
                    '-Wextra', '-Werror', '-pedantic', '-dynamiclib',
                    str(root / 'fixture.cpp'), '-o', fixture], check=True)
    subprocess.run(['node', '--expose-gc', str(root / 'session_test.cjs'),
                    str(root / 'build/accent-probe.node'), fixture], check=True, timeout=30)

subprocess.run(['node', str(root / 'identity_test.cjs')], check=True, timeout=15)
subprocess.run(['node', str(root / 'worker_test.cjs')], check=True, timeout=15)
with tempfile.TemporaryDirectory(prefix='openkrisp-ar-wire-') as directory:
    for name, flags in [('release', ['-O2']), ('sanitized', ['-O1', '-g', '-fsanitize=address,undefined'])]:
        binary = str(Path(directory) / name)
        subprocess.run(['clang++', '-std=c++20', '-arch', 'arm64', '-Wall', '-Wextra', '-Werror',
                        '-pedantic', *flags, str(root / 'wire_test.cpp'), '-o', binary], check=True)
        subprocess.run([binary], check=True, timeout=15)

with tempfile.TemporaryDirectory(prefix='openkrisp-ar-broker-') as directory:
    for name, flags in [('release', ['-O2']), ('sanitized', ['-O1', '-g', '-fsanitize=address,undefined'])]:
        binary = str(Path(directory) / name)
        subprocess.run(['clang++', '-std=c++20', '-arch', 'arm64', '-Wall', '-Wextra', '-Werror',
                        '-pedantic', *flags, str(root / 'broker_test.cpp'), str(root / 'worker_broker.cpp'),
                        '-o', binary], check=True)
        subprocess.run([binary, '/opt/homebrew/bin/node', str(root / 'broker_fixture.cjs')], check=True, timeout=30)
