# AEC route integration uses only our worker and synthetic AEC library.
python3 - <<'PY'
from pathlib import Path
import hashlib, shutil, subprocess, tempfile
root = Path.cwd()
probe = root.parent / 'native-model-probe'
with tempfile.TemporaryDirectory(prefix='openkrisp-aec-route-') as temporary:
    build = Path(temporary)
    worker, fixture = build / 'worker', build / 'fixture.dylib'
    common = ['clang++', '-mmacosx-version-min=12.0', '-std=c++20', '-pthread', '-Wall', '-Wextra', '-Werror']
    subprocess.run([*common, '-O2', str(probe / 'aec_worker.cpp'), '-o', str(worker)], check=True)
    subprocess.run([*common, '-O2', '-dynamiclib', str(probe / 'aec_fixture.cpp'), '-o', str(fixture)], check=True)
    digest = hashlib.sha256(fixture.read_bytes()).hexdigest()
    for name, flags in [('release', ['-O2']), ('sanitized', ['-O1', '-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer']), ('thread', ['-O1', '-g', '-fsanitize=thread'])]:
        binary = root / 'build' / ('installed-aec-adapter-' + name)
        subprocess.run([*common, '-fblocks', *flags, 'installed_aec_adapter_test.cpp', 'routing.cpp', 'recording.cpp', str(probe / 'aec_worker_broker.cpp'), '-framework', 'CoreAudio', '-framework', 'CoreFoundation', '-o', str(binary)], check=True)
        subprocess.run([str(binary), str(worker), str(fixture), digest], check=True, timeout=90)
        chain = root / 'build' / ('aec-microphone-chain-' + name)
        rnnoise = '../noise-engine/build/' + ('sanitized' if name == 'sanitized' else 'release') + '/librnnoise.a'
        subprocess.run([*common, '-fblocks', *flags, '-I../noise-engine/vendor/rnnoise/include', 'aec_microphone_chain_test.cpp', 'routing.cpp', 'recording.cpp', str(probe / 'aec_worker_broker.cpp'), str(probe / 'worker_broker.cpp'), rnnoise, '-framework', 'CoreAudio', '-framework', 'CoreFoundation', '-o', str(chain)], check=True)
        node = str(Path(shutil.which('node')).resolve())
        subprocess.run([str(chain), str(worker), str(fixture), digest, node, str(probe / 'worker_broker_fixture.cjs')], check=True, timeout=120)
        if name == 'release':
            subprocess.run([*common, '-fblocks', *flags, '-I../noise-engine/vendor/rnnoise/include', 'aec_microphone_chain_probe.cpp', 'routing.cpp', 'recording.cpp', str(probe / 'aec_worker_broker.cpp'), str(probe / 'worker_broker.cpp'), rnnoise, '-framework', 'CoreAudio', '-framework', 'CoreFoundation', '-o', str(root / 'build/aec-microphone-chain-probe')], check=True)
        comparison = root / 'build' / ('aec-chain-probe-test-' + name)
        subprocess.run([*common, '-fblocks', *flags, '-I../noise-engine/vendor/rnnoise/include', 'aec_microphone_chain_probe_test.cpp', 'routing.cpp', 'recording.cpp', str(probe / 'aec_worker_broker.cpp'), str(probe / 'worker_broker.cpp'), rnnoise, '-framework', 'CoreAudio', '-framework', 'CoreFoundation', '-o', str(comparison)], check=True)
        subprocess.run([str(comparison), str(worker), str(fixture), digest, node, str(root / 'aec_microphone_chain_probe_fixture.cjs')], check=True, timeout=120)
PY
