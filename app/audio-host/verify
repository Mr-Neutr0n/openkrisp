from pathlib import Path
import shutil, subprocess
root = Path.cwd()
node = str(Path(shutil.which('node')).resolve())
for name, flags, library in [
    ('release', ['-O2'], '../noise-engine/build/release/librnnoise.a'),
    ('sanitized', ['-O1', '-g', '-fsanitize=address,undefined'], '../noise-engine/build/sanitized/librnnoise.a'),
    ('thread', ['-O1', '-g', '-fsanitize=thread'], '../noise-engine/build/release/librnnoise.a'),
]:
    binary = root / 'build' / ('installed-noise-adapter-' + name)
    subprocess.run(['clang++', '-mmacosx-version-min=12.0', '-fblocks', '-std=c++20', '-pthread', '-Wall', '-Wextra', '-Werror',
                    *flags, '-I../noise-engine/vendor/rnnoise/include', 'installed_noise_adapter_test.cpp',
                    'routing.cpp', 'recording.cpp', '../native-model-probe/worker_broker.cpp', library,
                    '-framework', 'CoreAudio', '-framework', 'CoreFoundation', '-o', str(binary)], check=True)
    subprocess.run([str(binary), node, str(root.parent / 'native-model-probe/worker_broker_fixture.cjs')], check=True, timeout=60)
