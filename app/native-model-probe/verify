#!/usr/bin/env python3
"""Verify independent callback collection without loading any vendor component."""
from pathlib import Path
import subprocess
import tempfile
import shutil
import hashlib

root = Path(__file__).resolve().parent
with tempfile.TemporaryDirectory(prefix="openkrisp-native-probe-") as build:
    for name, flags in [
        ("release", ["-O2"]),
        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"]),
    ]:
        binary = str(Path(build) / name)
        subprocess.run([
            "clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra",
            "-Werror", "-pedantic", *flags,
            str(root / "result_collector_test.cpp"), "-o", binary,
        ], check=True)
        print(name, flush=True)
        subprocess.run([binary], check=True)

        library = str(Path(build) / (name + "-fixture.dylib"))
        client = str(Path(build) / (name + "-fixture-client"))
        common = ["clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra", "-Werror", "-pedantic", *flags]
        subprocess.run([*common, "-dynamiclib", str(root / "fixture_library.cpp"), "-o", library], check=True)
        subprocess.run([*common, str(root / "fixture_client.cpp"), "-o", client], check=True)
        subprocess.run([client, library], check=True)

with tempfile.TemporaryDirectory(prefix="openkrisp-aec-abi-") as build:
    for name, flags in [("release", ["-O2"]),
                        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"])]:
        common = ["clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra", "-Werror", "-pedantic", *flags]
        library = str(Path(build) / (name + "-aec-fixture.dylib"))
        client = str(Path(build) / (name + "-aec-fixture-test"))
        subprocess.run([*common, "-dynamiclib", str(root / "aec_fixture.cpp"), "-o", library], check=True)
        subprocess.run([*common, str(root / "aec_fixture_test.cpp"), "-o", client], check=True)
        print("aec-foreign-abi " + name, flush=True)
        subprocess.run([client, library], check=True, timeout=30)
        probe = str(Path(build) / (name + "-aec-direct-probe"))
        subprocess.run([*common, str(root / "aec_direct_probe.cpp"), "-o", probe], check=True)
        subprocess.run(["python3", str(root / "aec_direct_probe_test.py"), probe, library], check=True, timeout=60)
        doubletalk = str(Path(build) / (name + "-aec-doubletalk-probe"))
        subprocess.run([*common, str(root / "aec_doubletalk_probe.cpp"), "-o", doubletalk], check=True)
        subprocess.run(["python3", str(root / "aec_doubletalk_probe_test.py"), doubletalk, library], check=True, timeout=60)
        subprocess.run(["python3", str(root / "aec_doubletalk_probe_test.py"), doubletalk, library, "48000"], check=True, timeout=60)


subprocess.run(["node", str(root / "launcher_test.cjs")], check=True)
subprocess.run([str(root / "build_probe")], check=True)
subprocess.run(["node", str(root / "native_probe_test.cjs")], check=True)
subprocess.run(["node", str(root / "parent_watch_native_test.cjs")], check=True, timeout=60)
subprocess.run(["node", str(root / "parent_watch_integration_test.cjs"), str(root / "build/native-probe.node")], check=True, timeout=60)

with tempfile.TemporaryDirectory(prefix="openkrisp-persistent-") as build:
    fixture = str(Path(build) / "persistent-fixture.dylib")
    subprocess.run(["clang++", "-std=c++20", "-arch", "arm64", "-O2", "-Wall", "-Wextra", "-Werror", "-pedantic", "-dynamiclib", str(root / "persistent_fixture.cpp"), "-o", fixture], check=True)
    subprocess.run(["node", "--expose-gc", str(root / "persistent_session_test.cjs"), str(root / "build/native-probe.node"), fixture], check=True)
subprocess.run(["node", str(root / "persistent_launcher_test.cjs")], check=True)
subprocess.run(["node", str(root / "worker_protocol_test.cjs")], check=True)
subprocess.run(["node", str(root / "worker_session_test.cjs")], check=True, timeout=60)
subprocess.run(["node", str(root / "audio_worker_test.cjs")], check=True, timeout=60)

with tempfile.TemporaryDirectory(prefix="openkrisp-provider-transport-") as build:
    for name, flags in [
        ("release", ["-O2"]),
        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"]),
        ("thread", ["-O1", "-g", "-fsanitize=thread"]),
    ]:
        binary = str(Path(build) / name)
        subprocess.run([
            "clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra",
            "-Werror", "-pedantic", "-pthread", *flags,
            str(root / "provider_transport_test.cpp"), "-o", binary,
        ], check=True)
        print("provider-transport " + name, flush=True)
        subprocess.run([binary], check=True)

with tempfile.TemporaryDirectory(prefix="openkrisp-worker-wire-") as build:
    for name, flags in [
        ("release", ["-O2"]),
        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"]),
    ]:
        binary = str(Path(build) / name)
        subprocess.run([
            "clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra",
            "-Werror", "-pedantic", *flags,
            str(root / "worker_protocol_native_test.cpp"), "-o", binary,
        ], check=True)
        print("worker-wire " + name, flush=True)
        subprocess.run([binary], check=True, timeout=60)
        subprocess.run(["node", str(root / "worker_protocol_cross_test.cjs"), binary], check=True, timeout=60)

node = str(Path(shutil.which("node")).resolve())
with tempfile.TemporaryDirectory(prefix="openkrisp-worker-broker-") as build:
    for source in ["worker_broker_test.cpp", "provider_worker_test.cpp", "installed_worker_launch_test.cpp"]:
        variants = [("release", ["-O2"]),
                    ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"])]
        if source == "provider_worker_test.cpp":
            variants.append(("thread", ["-O1", "-g", "-fsanitize=thread"]))
        for name, flags in variants:
            binary = str(Path(build) / (source + "-" + name))
            subprocess.run([
                "clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra",
                "-Werror", "-pedantic", "-pthread", *flags,
                str(root / source), str(root / "worker_broker.cpp"), "-o", binary,
            ], check=True)
            print(source + " " + name, flush=True)
            arguments = [] if source == "installed_worker_launch_test.cpp" else [node, str(root / "worker_broker_fixture.cjs")]
            subprocess.run([binary, *arguments], check=True, timeout=60)

subprocess.run([
    "clang++", "-std=c++20", "-arch", "arm64", "-O2", "-Wall", "-Wextra",
    "-Werror", "-pedantic", "-pthread", str(root / "worker_broker.cpp"),
    str(root / "installed_worker_probe.cpp"), "-o", str(root / "build/installed-worker-probe"),
], check=True)

with tempfile.TemporaryDirectory(prefix="openkrisp-parent-watch-") as build:
    for name, flags in [("release", ["-O2"]),
                        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined"])]:
        binary = str(Path(build) / name)
        subprocess.run([
            "clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra",
            "-Werror", "-pedantic", "-pthread", *flags,
            str(root / "parent_watch_test.cpp"), "-o", binary,
        ], check=True)
        print("parent-watch " + name, flush=True)
        subprocess.run([binary], check=True, timeout=60)
subprocess.run([
    "clang++", "-std=c++20", "-arch", "arm64", "-O2", "-Wall", "-Wextra",
    "-Werror", "-pedantic", "-pthread", str(root / "worker_broker.cpp"),
    str(root / "timed_worker_probe.cpp"), "-o", str(root / "build/timed-worker-probe"),
], check=True)

with tempfile.TemporaryDirectory(prefix="openkrisp-aec-worker-") as build:
    for name, flags in [("release", ["-O2"]),
                        ("address-undefined", ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"])]:
        common = ["clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra", "-Werror", "-pedantic", "-pthread", *flags]
        wire = str(Path(build) / (name + "-wire"))
        broker = str(Path(build) / (name + "-broker"))
        fixture = str(Path(build) / (name + "-broker-fixture"))
        library = str(Path(build) / (name + "-aec-fixture.dylib"))
        worker = str(Path(build) / (name + "-worker"))
        subprocess.run([*common, str(root / "aec_worker_protocol_test.cpp"), "-o", wire], check=True)
        subprocess.run([*common, str(root / "aec_worker_broker_fixture.cpp"), "-o", fixture], check=True)
        subprocess.run([*common, str(root / "aec_worker_broker_test.cpp"), str(root / "aec_worker_broker.cpp"), "-o", broker], check=True)
        subprocess.run([*common, "-dynamiclib", str(root / "aec_fixture.cpp"), "-o", library], check=True)
        subprocess.run([*common, str(root / "aec_worker.cpp"), "-o", worker], check=True)
        print("aec-persistent-worker " + name, flush=True)
        subprocess.run([wire], check=True, timeout=60)
        subprocess.run([broker, fixture], check=True, timeout=60)
        subprocess.run(["python3", str(root / "aec_worker_test.py"), worker, library], check=True, timeout=60)
        integration = str(Path(build) / (name + "-integration"))
        subprocess.run([*common, str(root / "aec_worker_end_to_end_test.cpp"), str(root / "aec_worker_broker.cpp"), "-o", integration], check=True)
        digest = hashlib.sha256(Path(library).read_bytes()).hexdigest()
        subprocess.run([integration, worker, library, digest], check=True, timeout=60)
        launch = str(Path(build) / (name + "-aec-launch"))
        runtime = str(Path(build) / (name + "-aec-runtime-fixture"))
        production = str(Path(build) / (name + "-aec-runtime-probe"))
        subprocess.run([*common, str(root / "installed_aec_worker_launch_test.cpp"), "-o", launch], check=True)
        subprocess.run([launch], check=True, timeout=60)
        subprocess.run([*common, str(root / "aec_worker_runtime_fixture.cpp"), str(root / "aec_worker_broker.cpp"), "-o", runtime], check=True)
        subprocess.run([*common, str(root / "aec_worker_runtime_probe.cpp"), str(root / "aec_worker_broker.cpp"), "-o", production], check=True)
        subprocess.run(["python3", str(root / "aec_worker_runtime_test.py"), runtime, worker, library], check=True, timeout=60)
        transport = str(Path(build) / (name + "-aec-duplex-transport"))
        owner = str(Path(build) / (name + "-aec-duplex-owner"))
        subprocess.run([*common, str(root / "aec_duplex_transport_test.cpp"), "-o", transport], check=True)
        subprocess.run([transport], check=True, timeout=60)
        subprocess.run([*common, str(root / "aec_duplex_worker_test.cpp"), str(root / "aec_worker_broker.cpp"), "-o", owner], check=True)
        subprocess.run([owner, worker, library, digest, fixture], check=True, timeout=60)
        if name == "release":
            thread_common = ["clang++", "-std=c++20", "-arch", "arm64", "-Wall", "-Wextra", "-Werror", "-pedantic", "-pthread", "-O1", "-g", "-fsanitize=thread"]
            thread_transport = str(Path(build) / "thread-aec-duplex-transport")
            thread_owner = str(Path(build) / "thread-aec-duplex-owner")
            subprocess.run([*thread_common, str(root / "aec_duplex_transport_test.cpp"), "-o", thread_transport], check=True)
            subprocess.run([thread_transport], check=True, timeout=60)
            subprocess.run([*thread_common, str(root / "aec_duplex_worker_test.cpp"), str(root / "aec_worker_broker.cpp"), "-o", thread_owner], check=True)
            subprocess.run([thread_owner, worker, library, digest, fixture], check=True, timeout=60)
        paced = str(Path(build) / (name + "-aec-paced-fixture"))
        paced_production = str(Path(build) / (name + "-aec-paced-probe"))
        subprocess.run([*common, str(root / "aec_duplex_paced_fixture.cpp"), str(root / "aec_worker_broker.cpp"), "-o", paced], check=True)
        subprocess.run([*common, str(root / "aec_duplex_paced_probe.cpp"), str(root / "aec_worker_broker.cpp"), "-o", paced_production], check=True)
        paced_cases = [("480", "2"), ("4096", "2")] if name == "release" else [("512", "4")]
        for maximum, budget in paced_cases:
            subprocess.run(["python3", str(root / "aec_duplex_paced_test.py"), paced, worker, library, maximum, budget], check=True, timeout=60)
