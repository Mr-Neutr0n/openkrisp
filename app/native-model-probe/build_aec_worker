#!/usr/bin/env python3
"""Build/sign our packaged AEC worker. Never loads a vendor library."""
from pathlib import Path
import os
import stat
import subprocess
import tempfile

root = Path(__file__).resolve().parent
inputs = [root / name for name in (
    "build_aec_worker", "aec_worker.cpp", "aec_abi.hpp", "aec_worker_protocol.hpp", "parent_watch.hpp")]

def ordinary(path):
    return stat.S_ISREG(path.lstat().st_mode)

for source in inputs:
    if not ordinary(source):
        raise RuntimeError("Expected ordinary AEC worker source: " + str(source))
output = root / "build"
if output.is_symlink():
    raise RuntimeError("AEC worker build directory must not be a symlink")
output.mkdir(exist_ok=True)
target = output / "aec-worker-packaged"
if target.is_symlink() or (target.exists() and not ordinary(target)):
    raise RuntimeError("Expected ordinary packaged AEC worker output")
with tempfile.TemporaryDirectory(prefix="aec-worker-package-", dir=output) as temporary:
    worker = Path(temporary) / "aec-worker"
    subprocess.run([
        "clang++", "-std=c++20", "-arch", "arm64", "-mmacosx-version-min=12.0",
        "-O2", "-Wall", "-Wextra", "-Werror", "-pedantic", "-pthread",
        str(root / "aec_worker.cpp"), "-o", str(worker),
    ], check=True)
    if not ordinary(worker) or not worker.stat().st_mode & 0o111:
        raise RuntimeError("Packaged AEC worker must be an ordinary executable")
    if subprocess.check_output(["lipo", "-archs", str(worker)], text=True).strip() != "arm64":
        raise RuntimeError("Packaged AEC worker must be ARM64")
    if not any(line.strip() == "minos 12.0" for line in subprocess.check_output(["otool", "-l", str(worker)], text=True).splitlines()):
        raise RuntimeError("Packaged AEC worker must target macOS 12.0")
    subprocess.run(["codesign", "--force", "--sign", "-", "--identifier", "dev.labvoice.aec-worker", str(worker)], check=True)
    subprocess.run(["codesign", "--verify", "--strict", str(worker)], check=True)
    if any(source.stat().st_mtime_ns > worker.stat().st_mtime_ns for source in inputs):
        raise RuntimeError("AEC worker inputs are newer than the completed build")
    os.replace(worker, target)
print(target)
