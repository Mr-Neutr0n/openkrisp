#!/usr/bin/env python3
import pathlib
import plistlib
import shutil
import subprocess

root = pathlib.Path(__file__).resolve().parent
subprocess.run(["swift", "build", "-c", "release", "--package-path", str(root)], check=True)
binpath = subprocess.check_output(["swift", "build", "-c", "release", "--package-path", str(root), "--show-bin-path"], text=True).strip()
app = root / ".build" / "app" / "Lab Voice.app"
if app.exists():
    shutil.rmtree(app)
macos = app / "Contents" / "MacOS"
macos.mkdir(parents=True, exist_ok=True)
shutil.copy2(pathlib.Path(binpath) / "LabVoice", macos / "LabVoice")
# ModelCatalog resolves signed app resources under Contents/Resources.
for resource in pathlib.Path(binpath).glob("*.bundle"):
    shutil.copytree(resource, app / "Contents" / "Resources" / resource.name, dirs_exist_ok=True)
# The audio-host component builds this helper before desktop packaging.
helper_root = root.parent / "audio-host"
helper_source = helper_root / "build" / "audio-host"
if not helper_source.is_file():
    raise RuntimeError("Build app/audio-host with ./verify before packaging desktop.")
helper_inputs = [helper_root / name for name in (
    "host.cpp", "route_cli.cpp", "route_cli.hpp", "routing.cpp", "routing.hpp",
    "coreaudio_backend.cpp", "noise_adapter.hpp", "controls.hpp",
    "control_protocol.cpp", "control_protocol.hpp", "recording.cpp", "recording.hpp", "microphone_test.cpp", "microphone_test.hpp",
    "microphone_test_cli.cpp", "microphone_test_coreaudio.cpp")]
helper_inputs.append(root.parent / "noise-engine" / "build" / "release" / "librnnoise.a")
if any(path.stat().st_mtime_ns > helper_source.stat().st_mtime_ns for path in helper_inputs):
    raise RuntimeError("Audio helper is stale. Rebuild app/audio-host with ./verify before packaging desktop.")
helper_dir = app / "Contents" / "Resources" / "helper"
helper_dir.mkdir(parents=True, exist_ok=True)
helper = helper_dir / "audio-host"
shutil.copy2(helper_source, helper)
notices = helper_dir / "notices"
notices.mkdir()
shutil.copy2(root.parent / "noise-engine" / "vendor" / "rnnoise" / "COPYING", notices / "RNNoise-COPYING")
subprocess.run(["codesign", "--force", "--sign", "-", "--identifier", "dev.labvoice.audio-host", str(helper)], check=True)
subprocess.run(["codesign", "--verify", "--strict", str(helper)], check=True)
info = {
    "CFBundleName": "Lab Voice", "CFBundleDisplayName": "Lab Voice",
    "CFBundleIdentifier": "dev.labvoice.desktop", "CFBundleExecutable": "LabVoice",
    "CFBundlePackageType": "APPL", "CFBundleShortVersionString": "0.1.0",
    "CFBundleVersion": "1", "LSMinimumSystemVersion": "12.0",
    "NSHighResolutionCapable": True,
    "NSMicrophoneUsageDescription": "Lab Voice captures the microphone you select to route audio and optionally reduce noise on this Mac.",
    "NSSpeechRecognitionUsageDescription": "Lab Voice uses on-device speech recognition to transcribe WAV files you select. It does not record your microphone.",
}
with (app / "Contents" / "Info.plist").open("wb") as handle:
    plistlib.dump(info, handle)
subprocess.run(["codesign", "--force", "--sign", "-", str(app)], check=True)
subprocess.run(["codesign", "--verify", "--deep", "--strict", str(app)], check=True)
print(app)
