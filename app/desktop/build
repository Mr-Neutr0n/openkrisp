#!/usr/bin/env python3
import pathlib
import plistlib
import shutil
import subprocess
import hashlib
import json
import stat

root = pathlib.Path(__file__).resolve().parent
subprocess.run(["swift", "build", "-c", "release", "--package-path", str(root)], check=True)
binpath = subprocess.check_output(["swift", "build", "-c", "release", "--package-path", str(root), "--show-bin-path"], text=True).strip()
app = root / ".build" / "app" / "Lab Voice.app"
if app.exists():
    shutil.rmtree(app)
macos = app / "Contents" / "MacOS"
macos.mkdir(parents=True, exist_ok=True)
shutil.copy2(pathlib.Path(binpath) / "LabVoice", macos / "LabVoice")
# ModelCatalog resolves signed app resources under Contents/Resources.
for resource in pathlib.Path(binpath).glob("*.bundle"):
    shutil.copytree(resource, app / "Contents" / "Resources" / resource.name, dirs_exist_ok=True)
# The audio-host component builds this helper before desktop packaging.
helper_root = root.parent / "audio-host"
helper_source = helper_root / "build" / "audio-host"
if not helper_source.is_file() or helper_source.is_symlink():
    raise RuntimeError("Build app/audio-host with ./verify before packaging desktop.")
helper_inputs = [helper_root / name for name in (
    "host.cpp", "route_cli.cpp", "route_cli.hpp", "route_aec_ack.hpp", "routing.cpp", "routing.hpp",
    "coreaudio_backend.cpp", "noise_adapter.hpp", "installed_noise_adapter.hpp", "installed_aec_adapter.hpp", "controls.hpp",
    "control_protocol.cpp", "control_protocol.hpp", "recording.cpp", "recording.hpp", "microphone_test.cpp", "microphone_test.hpp",
    "microphone_test_cli.cpp", "microphone_test_coreaudio.cpp")]
helper_inputs.append(root.parent / "noise-engine" / "build" / "release" / "librnnoise.a")
worker_root = root.parent / "native-model-probe"
helper_inputs.extend(worker_root.glob("*.hpp"))
helper_inputs.extend(worker_root / name for name in ("worker_broker.cpp", "aec_worker_broker.cpp"))
if any(path.stat().st_mtime_ns > helper_source.stat().st_mtime_ns for path in helper_inputs):
    raise RuntimeError("Audio helper is stale. Rebuild app/audio-host with ./verify before packaging desktop.")
helper_dir = app / "Contents" / "Resources" / "helper"
helper_dir.mkdir(parents=True, exist_ok=True)
helper = helper_dir / "audio-host"
shutil.copy2(helper_source, helper)
notices = helper_dir / "notices"
notices.mkdir()
shutil.copy2(root.parent / "noise-engine" / "vendor" / "rnnoise" / "COPYING", notices / "RNNoise-COPYING")
subprocess.run(["codesign", "--force", "--sign", "-", "--identifier", "dev.labvoice.audio-host", str(helper)], check=True)
subprocess.run(["codesign", "--verify", "--strict", str(helper)], check=True)
# This separate output must not replace the frozen CPU-probe executable.
aec_source = worker_root / "build" / "aec-worker-packaged"
aec_inputs = [worker_root / name for name in (
    "build_aec_worker", "aec_worker.cpp", "aec_abi.hpp", "aec_worker_protocol.hpp", "parent_watch.hpp")]
if aec_source.parent.is_symlink() or not aec_source.is_file() or aec_source.is_symlink() or not aec_source.stat().st_mode & 0o111:
    raise RuntimeError("Build app/native-model-probe with ./build_aec_worker before packaging desktop.")
if any(not stat.S_ISREG(path.lstat().st_mode) for path in aec_inputs):
    raise RuntimeError("Expected ordinary AEC worker build inputs.")
if any(path.stat().st_mtime_ns > aec_source.stat().st_mtime_ns for path in aec_inputs):
    raise RuntimeError("AEC worker is stale. Run app/native-model-probe/build_aec_worker before packaging desktop.")
aec_dir = helper_dir / "aec-worker"
aec_dir.mkdir()
aec_worker = aec_dir / "aec-worker"
shutil.copy2(aec_source, aec_worker)
if subprocess.check_output(["lipo", "-archs", str(aec_worker)], text=True).strip() != "arm64":
    raise RuntimeError("AEC worker must be ARM64.")
if not any(line.strip() == "minos 12.0" for line in subprocess.check_output(["otool", "-l", str(aec_worker)], text=True).splitlines()):
    raise RuntimeError("AEC worker must target macOS 12.0.")
subprocess.run(["codesign", "--verify", "--strict", str(aec_source)], check=True)
subprocess.run(["codesign", "--force", "--sign", "-", "--identifier", "dev.labvoice.aec-worker", str(aec_worker)], check=True)
subprocess.run(["codesign", "--verify", "--strict", str(aec_worker)], check=True)
aec_manifest = {
    "schemaVersion": 1,
    "files": {"aec-worker": hashlib.sha256(aec_worker.read_bytes()).hexdigest()},
    "librarySha256": "bd75d4f1188c778647afab3899c731ecd31ecf4e05751a3e3fc632a616414a3a",
}
(aec_dir / "runtime-manifest.json").write_text(json.dumps(aec_manifest, indent=2) + "\n")
# Bundle only our adapter and worker code. Node, the vendor addon, models and
# dependency libraries remain at explicitly selected external installed paths.
worker_files = ("native-probe.node", "audio_worker.cjs", "worker_session.cjs", "worker_protocol.cjs")
adapter_source = worker_root / "build" / "native-probe.node"
adapter_inputs = [worker_root / "native_probe.cpp", worker_root / "build_probe", *worker_root.glob("*.hpp")]
if not adapter_source.is_file() or adapter_source.is_symlink():
    raise RuntimeError("Build app/native-model-probe with ./build_probe before packaging desktop.")
if any(path.stat().st_mtime_ns > adapter_source.stat().st_mtime_ns for path in adapter_inputs):
    raise RuntimeError("Native adapter is stale. Rebuild app/native-model-probe before packaging desktop.")
worker_dir = helper_dir / "installed-worker"
worker_dir.mkdir()
for name in worker_files:
    source = adapter_source if name == "native-probe.node" else worker_root / name
    if source.is_symlink() or not source.is_file():
        raise RuntimeError("Expected plain worker resource: " + name)
    shutil.copy2(source, worker_dir / name)
adapter = worker_dir / "native-probe.node"
if subprocess.check_output(["lipo", "-archs", str(adapter)], text=True).strip() != "arm64":
    raise RuntimeError("Native adapter must be ARM64.")
if "minos 12.0" not in subprocess.check_output(["otool", "-l", str(adapter)], text=True):
    raise RuntimeError("Native adapter must target macOS 12.0.")
subprocess.run(["codesign", "--force", "--sign", "-", "--identifier", "dev.labvoice.native-probe", str(adapter)], check=True)
subprocess.run(["codesign", "--verify", "--strict", str(adapter)], check=True)
# Signing changes Mach-O bytes. Record only the final signed adapter identity.
manifest = {
    "schemaVersion": 1,
    "nodeSha256": "1ef99ea25fe70c9b67e7efe768ef8ee22148d3cabc703db6131b57aeb617d040",
    "files": {name: hashlib.sha256((worker_dir / name).read_bytes()).hexdigest() for name in worker_files},
}
(worker_dir / "runtime-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
info = {
    "CFBundleName": "Lab Voice", "CFBundleDisplayName": "Lab Voice",
    "CFBundleIdentifier": "dev.labvoice.desktop", "CFBundleExecutable": "LabVoice",
    "CFBundlePackageType": "APPL", "CFBundleShortVersionString": "0.1.0",
    "CFBundleVersion": "1", "LSMinimumSystemVersion": "12.0",
    "NSHighResolutionCapable": True,
    "NSMicrophoneUsageDescription": "Lab Voice captures the microphone you select to route audio and optionally reduce noise on this Mac.",
    "NSSpeechRecognitionUsageDescription": "Lab Voice uses on-device speech recognition to transcribe WAV files you select. It does not record your microphone.",
}
with (app / "Contents" / "Info.plist").open("wb") as handle:
    plistlib.dump(info, handle)
subprocess.run(["codesign", "--force", "--sign", "-", str(app)], check=True)
subprocess.run(["codesign", "--verify", "--deep", "--strict", str(app)], check=True)
print(app)
